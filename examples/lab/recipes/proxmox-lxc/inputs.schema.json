{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Address and MAC patterns end with a negative lookahead because $ alone can accept a trailing newline.",
  "title": "proxmox-lxc inputs",
  "type": "object",
  "properties": {
    "hardware": {
      "type": "object",
      "properties": {
        "cores": { "type": "integer", "minimum": 1, "maximum": 128 },
        "memory": { "description": "MiB", "type": "integer", "minimum": 256 },
        "swap": { "description": "MiB", "type": "integer", "minimum": 0 },
        "disks": {
          "description": "The root disk. Declare other storage as mount points.",
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "size": { "description": "GiB", "type": "integer", "minimum": 1 },
              "datastore": { "type": "string" }
            },
            "required": ["size"],
            "additionalProperties": false
          }
        },
        "mountPoints": {
          "description": "Changing one replaces the container, and Proxmox refuses that while it is protected.",
          "type": "array",
          "items": { "$ref": "#/$defs/mountPoint" }
        }
      },
      "required": ["cores", "memory", "disks"],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "bridge": { "type": "string" },
        "mode": { "enum": ["static", "dhcp"] },
        "address": { "$ref": "#/$defs/ipv4Cidr" },
        "gateway": { "$ref": "#/$defs/ipv4" },
        "reservedAddress": {
          "$ref": "#/$defs/ipv4",
          "description": "Expected IPv4 address of an externally configured DHCP reservation; does not configure the DHCP server or a static guest address."
        },
        "vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
        "mac": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f][02468AaCcEe](:[0-9A-Fa-f]{2}){5}(?![\\s\\S])",
          "not": { "const": "00:00:00:00:00:00" }
        },
        "dns": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["bridge", "mode"],
      "if": {
        "properties": { "mode": { "const": "static" } }
      },
      "then": { "required": ["address", "gateway"] },
      "else": { "properties": { "address": false, "gateway": false } },
      "dependentSchemas": {
        "reservedAddress": {
          "properties": { "mode": { "const": "dhcp" } },
          "required": ["mac"]
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "startup": { "$ref": "#/$defs/startup" },
        "firewall": {
          "description": "Proxmox firewall rules for the container. Inert unless the datacenter firewall is enabled.",
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "proto": { "enum": ["tcp", "udp"] },
                  "dport": { "type": "string" },
                  "source": { "type": "string" },
                  "comment": { "type": "string" }
                },
                "required": ["proto", "dport"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["hardware", "network"],
  "$defs": {
    "ipv4": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?![\\s\\S])"
    },
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])(?![\\s\\S])"
    },
    "mountPoint": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+(?![\\s\\S])" },
        "size": {
          "description": "GiB of a new volume, which Proxmox deletes with the container.",
          "type": "integer",
          "minimum": 1
        },
        "datastore": {
          "description": "Where to create the new volume; the host's disks datastore by default.",
          "type": "string"
        },
        "volume": {
          "description": "An existing volume to mount instead of a new one. Proxmox keeps a volume another VMID owns when it deletes the container.",
          "type": "string"
        },
        "backup": { "description": "Whether a vzdump backup holds the volume. Defaults to true.", "type": "boolean" }
      },
      "required": ["path"],
      "oneOf": [
        { "required": ["size"] },
        { "required": ["volume"] }
      ],
      "dependentSchemas": {
        "volume": { "properties": { "datastore": false } }
      },
      "additionalProperties": false
    },
    "startup": {
      "description": "When Proxmox starts this container at boot, relative to the host's other guests.",
      "type": "object",
      "properties": {
        "order": { "type": "integer", "minimum": 0 },
        "upDelay": { "description": "Seconds before the next guest starts.", "type": "integer", "minimum": 0 },
        "downDelay": { "description": "Seconds before the next guest stops.", "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
