{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proxmox-vm inputs",
  "type": "object",
  "properties": {
    "hardware": {
      "type": "object",
      "properties": {
        "cores": { "type": "integer", "minimum": 1, "maximum": 128 },
        "memory": { "description": "MiB", "type": "integer", "minimum": 256 },
        "cpuType": { "type": "string" },
        "disks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "size": { "description": "GiB", "type": "integer", "minimum": 1 },
              "datastore": { "type": "string" }
            },
            "required": ["size"],
            "additionalProperties": false
          }
        }
      },
      "required": ["cores", "memory", "disks"],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "bridge": { "type": "string" },
        "mode": { "enum": ["static", "dhcp"] },
        "address": { "type": "string", "pattern": "^[0-9.]+/[0-9]{1,2}$" },
        "gateway": { "type": "string" },
        "vlan": { "type": "integer", "minimum": 1, "maximum": 4094 },
        "mac": { "type": "string" },
        "dns": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["bridge", "mode"],
      "if": { "properties": { "mode": { "const": "static" } } },
      "then": { "required": ["address", "gateway"] },
      "additionalProperties": false
    }
  },
  "required": ["hardware", "network"]
}
