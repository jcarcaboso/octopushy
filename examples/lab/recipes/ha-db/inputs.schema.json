{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Address and MAC patterns end with a negative lookahead because $ alone can accept a trailing newline.",
  "title": "ha-db inputs",
  "type": "object",
  "properties": {
    "hardware": {
      "type": "object",
      "properties": {
        "cores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "memory": {
          "description": "MiB. Both databases run in it, so leave room: 1024 is the tested size.",
          "type": "integer",
          "minimum": 512
        },
        "swap": {
          "description": "MiB",
          "type": "integer",
          "minimum": 0
        },
        "disks": {
          "description": "The root disk, which holds both databases, their dumps, and the system. A volume of its own would not outlive the container, so there is no mount point.",
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "size": {
                "description": "GiB",
                "type": "integer",
                "minimum": 8
              },
              "datastore": {
                "type": "string"
              }
            },
            "required": [
              "size"
            ],
            "additionalProperties": false
          }
        },
        "mountPoints": {
          "description": "None: everything is on the root disk.",
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "cores",
        "memory",
        "disks"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "bridge": {
          "type": "string"
        },
        "mode": {
          "const": "static",
          "description": "OpenTofu installs over SSH, so the address must be known without asking Proxmox."
        },
        "address": {
          "$ref": "#/$defs/ipv4Cidr"
        },
        "gateway": {
          "$ref": "#/$defs/ipv4"
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f][02468AaCcEe](:[0-9A-Fa-f]{2}){5}(?![\\s\\S])",
          "not": {
            "const": "00:00:00:00:00:00"
          }
        },
        "dns": {
          "description": "What the container resolves through. The host's resolvers by default.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ipv4"
          }
        }
      },
      "required": [
        "bridge",
        "mode",
        "address",
        "gateway"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "properties": {
        "startup": {
          "$ref": "#/$defs/startup"
        },
        "postgresql": {
          "type": "object",
          "properties": {
            "clients": {
              "description": "The only addresses pg_hba lets in, each as a single host: Home Assistant's.",
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/ipv4"
              }
            }
          },
          "required": [
            "clients"
          ],
          "additionalProperties": false
        },
        "victoriametrics": {
          "description": "Exact pins. Leave it out for the version the recipe was tested with. Changing one installs again through the normal plan and apply.",
          "type": "object",
          "properties": {
            "version": {
              "description": "Of the single-node release.",
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?![\\s\\S])"
            },
            "sha256": {
              "description": "Of victoria-metrics-linux-amd64-v<version>.tar.gz.",
              "type": "string",
              "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
            },
            "retention": {
              "description": "How long samples are kept: a number and d, w, m, or y.",
              "type": "string",
              "pattern": "^[1-9][0-9]{0,2}[dwmy](?![\\s\\S])"
            }
          },
          "dependentRequired": {
            "version": [
              "sha256"
            ],
            "sha256": [
              "version"
            ]
          },
          "additionalProperties": false
        },
        "credentialsRevision": {
          "description": "Changing a password in the store starts no run, because a plan cannot see it. Raise this together with the store entry's version and both databases take the new password.",
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "postgresql"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "hardware",
    "network",
    "inputs"
  ],
  "$defs": {
    "ipv4": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?![\\s\\S])"
    },
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])(?![\\s\\S])"
    },
    "startup": {
      "description": "When Proxmox starts this container at boot, relative to the host's other guests.",
      "type": "object",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "upDelay": {
          "description": "Seconds before the next guest starts.",
          "type": "integer",
          "minimum": 0
        },
        "downDelay": {
          "description": "Seconds before the next guest stops.",
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
