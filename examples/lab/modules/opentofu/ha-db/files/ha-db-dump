#!/bin/sh
# One dump per weekday, so seven are kept. It is written beside the old one and moved over it only
# when it is whole, so a dump that fails never replaces a good one. These sit on the container's own
# disk and die with it: they cover mistakes, not a disk failure. docs/lxc-recipes.md says what does.
set -eu
dir=/var/backups/postgresql
name=homeassistant-$(date +%a).dump
trap 'rm -f "$dir/.$name.partial"' EXIT
pg_dump -Fc -f "$dir/.$name.partial" homeassistant
mv -f "$dir/.$name.partial" "$dir/$name"
