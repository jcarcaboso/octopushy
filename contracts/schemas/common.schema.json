{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.octopushy.invalid/v1/common.schema.json",
  "title": "Shared definitions",
  "$defs": {
    "id": {
      "description": "A resource id: lowercase letters, digits, and hyphens, as used for folder names.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "workflowRef": {
      "description": "A workflow and its version: <id>@<M> takes the newest M.x, <id>@<M.m> exactly that one. A reference without a version is invalid, so a major version is never adopted by accident.",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?@(0|[1-9][0-9]{0,8})(\\.(0|[1-9][0-9]{0,8}))?(?![\\s\\S])"
    },
    "schemaVersion": { "const": 1 },
    "extraVar": {
      "description": "An Ansible extra var. Names starting with ansible_ or octopushy are how Octopushy pins a connection, so they are refused.",
      "type": "string",
      "pattern": "^(?![Aa][Nn][Ss][Ii][Bb][Ll][Ee]_|[Oo][Cc][Tt][Oo][Pp][Uu][Ss][Hh][Yy])[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
    },
    "storeRef": {
      "description": "A reference to a variable-store entry, optionally at an exact version. Definitions never hold secret values.",
      "type": "object",
      "properties": {
        "store": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      },
      "required": ["store"],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "approval": { "enum": ["automatic", "manual"] },
        "destructive": { "enum": ["automatic", "manual"] },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "days": { "type": "array", "items": { "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] }, "minItems": 1 },
              "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
              "hours": { "type": "number", "exclusiveMinimum": 0, "maximum": 168 }
            },
            "required": ["days", "start", "hours"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "guestPolicy": {
      "type": "object",
      "properties": {
        "approval": { "$ref": "#/$defs/policy/properties/approval" },
        "destructive": { "$ref": "#/$defs/policy/properties/destructive" },
        "windows": { "$ref": "#/$defs/policy/properties/windows" },
        "actions": {
          "type": "object",
          "description": "Approval for one action of the workflow's Ansible stage, setup included, whatever starts it: a commit, a schedule or a person. It replaces approval for that action only; destructive still applies.",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "approval": { "enum": ["automatic", "manual"] }
            },
            "required": ["approval"],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "agentLabels": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "verify": { "type": "boolean" },
        "caCertificate": { "$ref": "#/$defs/storeRef" }
      },
      "additionalProperties": false
    }
  }
}
