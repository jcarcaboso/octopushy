{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.octopushy.invalid/v1/service.schema.json",
  "title": "Service instance (.../guests/<guest>/services/<service>/service.yaml)",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "description": { "type": "string" },
    "deploy": {
      "type": "object",
      "properties": {
        "recipe": { "$ref": "common.schema.json#/$defs/id", "description": "A recipe with operation: configure, as for a guest's setup." },
        "inputs": {
          "description": "Extra vars for the playbook, validated by the recipe's inputs schema.",
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" }
        },
        "secrets": {
          "description": "Extra vars filled from the store. Only the playbook step receives them.",
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/storeRef" }
        },
        "secretFiles": {
          "description": "Extra vars set to the path of a private file holding the value.",
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/storeRef" }
        }
      },
      "required": ["recipe"],
      "additionalProperties": false
    },
    "ports": {
      "description": "What this service listens on. Octopushy shows these and hands them to the playbook as octopushy.ports, which is what applies a limit. It opens and closes nothing itself.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "protocol": { "enum": ["tcp", "udp"] },
          "sources": {
            "description": "The IPv4 addresses or networks that may connect. Left out, a port is open to every source.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}(/[0-9]{1,2})?(?![\\s\\S])" }
          }
        },
        "required": ["port", "protocol"],
        "additionalProperties": false
      }
    },
    "execution": { "$ref": "common.schema.json#/$defs/execution" },
    "policy": { "$ref": "common.schema.json#/$defs/policy" }
  },
  "required": ["schemaVersion", "deploy"],
  "additionalProperties": false
}
