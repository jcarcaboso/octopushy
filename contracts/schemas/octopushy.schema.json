{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.octopushy.invalid/v1/octopushy.schema.json",
  "title": "Repository settings (octopushy.yaml)",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "workflows": {
      "description": "Where guests and services find the workflows they name. local, the default, is this repository's workflows/ folder, where each workflow's version is the one its workflow.yaml declares. A separate workflows repository, resolved by tags, comes later.",
      "type": "object",
      "properties": {
        "source": { "const": "local" }
      },
      "additionalProperties": false
    },
    "defaults": {
      "type": "object",
      "properties": {
        "policy": { "$ref": "common.schema.json#/$defs/policy" },
        "execution": { "$ref": "common.schema.json#/$defs/execution" }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion"],
  "additionalProperties": false
}
