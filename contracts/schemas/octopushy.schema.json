{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.octopushy.invalid/v1/octopushy.schema.json",
  "title": "Repository settings (octopushy.yaml)",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "defaults": {
      "type": "object",
      "properties": {
        "policy": { "$ref": "common.schema.json#/$defs/policy" },
        "execution": { "$ref": "common.schema.json#/$defs/execution" }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion"],
  "additionalProperties": false
}
