{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.octopushy.invalid/v1/installation.schema.json",
  "title": "Proxmox installation (labs/<lab>/proxmox/<installation>/installation.yaml)",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "manage": {
      "description": "Whether Octopushy may change anything in this installation. false makes it observed only: no guest or service may be defined under it, no run is ever created for it, and its token goes only to observations.",
      "type": "boolean",
      "default": true
    },
    "type": { "enum": ["standalone", "cluster"] },
    "connection": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https?://" },
        "tls": { "$ref": "common.schema.json#/$defs/tls" },
        "token": { "$ref": "common.schema.json#/$defs/storeRef" },
        "readOnlyToken": { "$ref": "common.schema.json#/$defs/storeRef" },
        "privilegedToken": { "$ref": "common.schema.json#/$defs/storeRef" }
      },
      "required": ["endpoint"],
      "oneOf": [
        {
          "required": ["token"],
          "not": { "anyOf": [{ "required": ["readOnlyToken"] }, { "required": ["privilegedToken"] }] }
        },
        {
          "required": ["readOnlyToken", "privilegedToken"],
          "not": { "required": ["token"] }
        }
      ],
      "additionalProperties": false
    },
    "hosts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "endpoint": { "type": "string", "pattern": "^https?://" },
          "datastores": {
            "type": "object",
            "properties": {
              "images": { "description": "Where downloaded images go.", "type": "string" },
              "disks": { "description": "Default datastore for guest disks.", "type": "string" }
            },
            "additionalProperties": { "type": "string" }
          },
          "bridges": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "limits": {
            "type": "object",
            "properties": {
              "concurrentOperations": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "execution": { "$ref": "common.schema.json#/$defs/execution" },
    "policy": { "$ref": "common.schema.json#/$defs/policy" },
    "snippets": {
      "description": "Lets Octopushy upload a guest's cloud-init snippet to these hosts over SFTP, as deploy/proxmox/snippets.sh sets up once on each. A guest whose workflow's machine stage has hostKey: managed then gets a host key of Octopushy's.",
      "type": "object",
      "properties": {
        "datastore": { "description": "A directory datastore with snippets content. Default: local.", "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
        "user": { "description": "The SFTP-only account on each host. Default: octopushy-snippets.", "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
        "hosts": {
          "description": "Each host set up for uploads, by its id under hosts.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "hostKey": { "description": "The host's own SSH public host key, as snippets.sh prints it, in a plain store entry. An upload connects to nothing else.", "$ref": "common.schema.json#/$defs/storeRef" },
              "address": { "description": "Where the host's sshd listens. Default: the host of its API endpoint.", "type": "string", "minLength": 1 },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            },
            "required": ["hostKey"],
            "additionalProperties": false
          }
        }
      },
      "required": ["hosts"],
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "type", "connection", "hosts"],
  "additionalProperties": false
}
