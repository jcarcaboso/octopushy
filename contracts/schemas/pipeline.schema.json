{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.octopushy.invalid/v1/pipeline.schema.json",
  "title": "Service pipeline (guests/<guest>/services/<service>/pipeline.yaml)",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "description": { "type": "string" },
    "stages": {
      "description": "What the service needs, in order. All are planned and previewed, approved once, then applied in this order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "description": "Unique in this pipeline.", "$ref": "common.schema.json#/$defs/id" },
          "recipe": { "description": "A recipe with operation: configure, whose onChange action runs, or operation: stage.", "$ref": "common.schema.json#/$defs/id" },
          "inputs": {
            "description": "Added to the pipeline's inputs for this stage, replacing a name they share.",
            "type": "object",
            "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" }
          },
          "secrets": {
            "description": "Extra vars filled from the variable store, for an Ansible stage. Only the step that runs the playbook receives them.",
            "type": "object",
            "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" },
            "additionalProperties": { "$ref": "common.schema.json#/$defs/storeRef" }
          },
          "secretFiles": {
            "description": "Extra vars holding the path of a private file with the store value, for an Ansible stage.",
            "type": "object",
            "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" },
            "additionalProperties": { "$ref": "common.schema.json#/$defs/storeRef" }
          }
        },
        "required": ["name", "recipe"],
        "additionalProperties": false
      }
    },
    "inputs": {
      "description": "Given to every stage. Octopushy does not interpret them: what a port or a name means is the recipe's.",
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" }
    },
    "policy": { "$ref": "common.schema.json#/$defs/policy" },
    "execution": { "$ref": "common.schema.json#/$defs/execution" }
  },
  "required": ["schemaVersion", "stages"],
  "additionalProperties": false
}
