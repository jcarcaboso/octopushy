{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.octopushy.invalid/v1/guest.schema.json",
  "title": "Guest (.../guests/<guest>/guest.yaml)",
  "type": "object",
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "description": { "type": "string" },
    "type": { "const": "vm", "description": "Proxmox containers come later." },
    "lifecycle": { "enum": ["active", "retired"] },
    "renamedFrom": { "$ref": "common.schema.json#/$defs/id" },
    "host": { "$ref": "common.schema.json#/$defs/id" },
    "vmid": { "type": "integer", "minimum": 100, "maximum": 999999999 },
    "template": { "$ref": "common.schema.json#/$defs/id" },
    "profiles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "hardware": { "description": "Validated by the provisioning recipe's inputs schema.", "type": "object" },
    "network": { "description": "Validated by the provisioning recipe's inputs schema.", "type": "object" },
    "provision": {
      "type": "object",
      "properties": {
        "recipe": { "$ref": "common.schema.json#/$defs/id" },
        "state": {
          "description": "An external OpenTofu backend from octopushy.yaml. Leave it out to keep the state in Octopushy.",
          "type": "object",
          "properties": { "backend": { "$ref": "common.schema.json#/$defs/id" } },
          "required": ["backend"],
          "additionalProperties": false
        }
      },
      "required": ["recipe"],
      "additionalProperties": false
    },
    "setup": {
      "description": "Post-provision guest setup: disk reporting, and a configure recipe.",
      "type": "object",
      "properties": {
        "recipe": { "description": "A recipe with operation: configure.", "$ref": "common.schema.json#/$defs/id" },
        "inputs": {
          "description": "Extra vars for the recipe, validated by its inputs schema.",
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" }
        },
        "secrets": {
          "description": "Extra vars filled from the variable store. Only the step that runs the playbook receives them.",
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/storeRef" }
        },
        "schedules": {
          "description": "Actions of the recipe to run on their own, at times in the lab's timezone.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": { "description": "An action of the recipe.", "$ref": "common.schema.json#/$defs/id" },
              "cron": { "description": "Five fields: minute, hour, day of the month, month, day of the week.", "type": "string", "minLength": 9 }
            },
            "required": ["action", "cron"],
            "additionalProperties": false
          }
        },
        "secretFiles": {
          "description": "Extra vars holding the path of a private file with the store value, for tasks that copy a file.",
          "type": "object",
          "propertyNames": { "$ref": "common.schema.json#/$defs/extraVar" },
          "additionalProperties": { "$ref": "common.schema.json#/$defs/storeRef" }
        },
        "diskReporter": {
          "description": "Overrides automatic disk reporting when it is enabled on the control plane.",
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "intervalSeconds": { "type": "integer", "minimum": 60, "maximum": 604800 }
          },
          "additionalProperties": false
        }
      }
    },
    "access": {
      "type": "object",
      "properties": {
        "address": { "description": "Where a configure run connects; by default the guest's static or reserved address.", "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*(?![\\s\\S])" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "user": { "description": "The login of a configure run.", "type": "string", "pattern": "^[a-z_][a-z0-9_.-]*(?![\\s\\S])" },
        "sshKey": { "description": "For a machine Octopushy did not create: an unencrypted OpenSSH private key, stored as a secret. Without it, Octopushy generates and uses its own key for this guest.", "$ref": "common.schema.json#/$defs/storeRef" },
        "hostKey": { "description": "The guest's public SSH host key, read through a trusted channel and stored by an operator. Octopushy never scans for it.", "$ref": "common.schema.json#/$defs/storeRef" },
        "sshAuthorizedKeys": { "type": "array", "items": { "type": "string", "pattern": "^(ssh-|ecdsa-|sk-)" } }
      },
      "additionalProperties": false
    },
    "execution": { "$ref": "common.schema.json#/$defs/execution" },
    "policy": { "$ref": "common.schema.json#/$defs/policy" }
  },
  "required": ["schemaVersion", "type", "host", "vmid", "provision"],
  "additionalProperties": false
}
