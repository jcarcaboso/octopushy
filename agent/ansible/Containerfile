# The Ansible image the agent starts for a guest's configuration: ansible-core from a hashed
# lock, the SSH client, and the program that runs it. Its entrypoint is `octopushy-ansible`,
# so the agent runs it as it runs the OpenTofu image. Build from the repository root:
#   podman build -f agent/ansible/Containerfile -t octopushy-ansible .
# images.yml publishes it under a tag that names its content; see docs/guest-configuration.md.
FROM docker.io/library/debian:trixie-slim@sha256:1e1a22175fbf1b32157ddaf0219e1db4e5401fab2b94ed285add64d18587cd2d
# libnss-wrapper: ssh needs a passwd entry, and an agent's --user has none on this image.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates libnss-wrapper openssh-client python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*
COPY agent/ansible/ /tmp/ansible/
RUN python3 -m venv /opt/octopushy/ansible \
 && /opt/octopushy/ansible/bin/pip install --no-cache-dir --require-hashes --no-deps -r /tmp/ansible/requirements.lock \
 && install -D -m 0755 /tmp/ansible/octopushy-ansible /opt/octopushy/ansible/lib/octopushy/octopushy-ansible \
 && install -D -m 0644 /tmp/ansible/octopushy_recap.py /opt/octopushy/ansible/lib/octopushy/octopushy_recap.py \
 && sed -i '1c #!/opt/octopushy/ansible/bin/python3' /opt/octopushy/ansible/lib/octopushy/octopushy-ansible \
 && ln -s /opt/octopushy/ansible/lib/octopushy/octopushy-ansible /usr/local/bin/octopushy-ansible \
 && rm -rf /tmp/ansible
ENTRYPOINT ["/usr/local/bin/octopushy-ansible"]
