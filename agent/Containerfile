# The agent image: the `octopushy` binary, OpenTofu and Ansible, which the agent runs directly
# (`--tool-runtime local`), so it needs no container runtime of its own. The Compose
# project runs it as the internal agent. Build from the repository root:
#   podman build -f agent/Containerfile -t octopushy-agent:<version> .
FROM docker.io/library/rust:1.98.1-trixie AS build
WORKDIR /src
COPY contracts/ contracts/
COPY agent/ agent/
RUN cd agent && cargo build --release --locked --bin octopushy

# The same OpenTofu release the podman and docker runtimes use (tools/mod.rs).
FROM ghcr.io/opentofu/opentofu:1.13.1-minimal AS tofu

# The same locked Ansible as the image a container runtime would start (agent/ansible).
FROM docker.io/library/debian:trixie-slim AS ansible
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates python3 python3-venv
COPY agent/ansible/ /tmp/ansible/
RUN cd /tmp/ansible && sh install.sh

FROM docker.io/library/debian:trixie-slim
# git: OpenTofu module sources may be Git repositories.
RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates git openssh-client python3 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --user-group --home-dir /var/lib/octopushy-agent --shell /usr/sbin/nologin octopushy-agent \
 && install -d -o octopushy-agent -g octopushy-agent -m 0700 /var/lib/octopushy-agent
COPY --from=tofu /usr/local/bin/tofu /usr/local/bin/tofu
COPY --from=ansible /opt/octopushy/ansible /opt/octopushy/ansible
# A link, as install.sh makes it, not a copy: octopushy-ansible finds its recap callback next to
# the file the link names. A copy here loads no callback, and every run ends uncertain.
RUN ln -s /opt/octopushy/ansible/lib/octopushy/octopushy-ansible /usr/local/bin/octopushy-ansible
COPY --from=build /src/agent/target/release/octopushy /usr/local/bin/octopushy
COPY --chmod=0755 agent/packaging/container-entrypoint.sh /usr/local/bin/octopushy-agent-entrypoint
# The build fails unless a playbook run through octopushy-ansible ends with a recap.
RUN printf -- '- hosts: localhost\n  gather_facts: false\n  tasks:\n    - ansible.builtin.debug: { msg: ok }\n' >/tmp/recap.yml \
 && OCTOPUSHY_RECAP=1 octopushy-ansible -i localhost, -c local /tmp/recap.yml 2>&1 >/dev/null | grep '^octopushy-recap: ' \
 && rm /tmp/recap.yml
USER octopushy-agent
ENV STATE_DIRECTORY=/var/lib/octopushy-agent \
    HOME=/var/lib/octopushy-agent \
    OCTOPUSHY_LOG=info
VOLUME /var/lib/octopushy-agent
ENTRYPOINT ["/usr/local/bin/octopushy-agent-entrypoint"]
