# Serves the built frontend and forwards /api to the backend, so the browser sees one
# origin (cookie session, no CORS). Plain HTTP on :8081; put TLS in front, or let Caddy
# do it later by replacing the address.
{
	admin off
	auto_https off
	persist_config off
	servers {
		# A TLS proxy in front (on a private network) keeps its X-Forwarded-Proto.
		trusted_proxies static private_ranges
	}
}

:8081 {
	encode zstd gzip

	header {
		# Monaco (the repository editor) adds its theme and token colors as <style> elements, so
		# styles allow inline; scripts and workers stay limited to this origin.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	handle /api/* {
		# reverse_proxy sets X-Forwarded-For/-Host/-Proto: the scheme of this request, or the
		# incoming value when the request comes from a trusted proxy (see above).
		reverse_proxy {$OCTOPUSHY_BACKEND:backend:8080}
	}

	# Hashed build output never changes under the same name.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the single-page app; index.html is always revalidated.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
