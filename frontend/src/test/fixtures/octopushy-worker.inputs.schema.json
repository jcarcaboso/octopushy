{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Validates { hardware, network, inputs } from a guest. hardware and network reach the machine stage (modules/opentofu/proxmox-vm) as guest.hardware and guest.network. Patterns end with a negative lookahead because $ alone can accept a trailing newline.",
  "title": "octopushy-worker",
  "description": "A Fedora VM running an Octopushy agent.",
  "type": "object",
  "properties": {
    "hardware": {
      "type": "object",
      "properties": {
        "cores": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "memory": {
          "description": "MiB",
          "type": "integer",
          "minimum": 256
        },
        "cpuType": {
          "type": "string"
        },
        "disks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "size": {
                "description": "GiB",
                "type": "integer",
                "minimum": 1
              },
              "datastore": {
                "type": "string"
              }
            },
            "required": [
              "size"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cores",
        "memory",
        "disks"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "bridge": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "static",
            "dhcp"
          ]
        },
        "address": {
          "$ref": "#/$defs/ipv4Cidr"
        },
        "gateway": {
          "$ref": "#/$defs/ipv4"
        },
        "reservedAddress": {
          "$ref": "#/$defs/ipv4",
          "description": "Expected IPv4 address of an externally configured DHCP reservation; does not configure the DHCP server or a static guest address."
        },
        "vlan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4094
        },
        "mac": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f][02468AaCcEe](:[0-9A-Fa-f]{2}){5}(?![\\s\\S])",
          "not": {
            "const": "00:00:00:00:00:00"
          }
        },
        "dns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "bridge",
        "mode"
      ],
      "if": {
        "properties": {
          "mode": {
            "const": "static"
          }
        }
      },
      "then": {
        "required": [
          "address",
          "gateway"
        ]
      },
      "else": {
        "properties": {
          "address": false,
          "gateway": false
        }
      },
      "dependentSchemas": {
        "reservedAddress": {
          "properties": {
            "mode": {
              "const": "dhcp"
            }
          },
          "required": [
            "mac"
          ]
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "description": "Extra vars for the setup stage (modules/ansible/octopushy-agent). The enrollment token is the secret worker_enrollment_token.",
      "type": "object",
      "properties": {
        "worker_server_url": {
          "description": "The server's agent endpoint, as agents reach it: https://<agent host>:8443, the name in the endpoint's certificate.",
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?/?(?![\\s\\S])"
        },
        "worker_agent_version": {
          "description": "The agent image to run: a release, such as 0.4.0 for agent-0.4.0, or a build of one commit, sha-<40 hex> for agent-sha-<commit>. Moving it is a commit, and setup restarts the agent on the new image.",
          "type": "string",
          "pattern": "^((0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)|sha-[0-9a-f]{40})(?![\\s\\S])"
        },
        "worker_agent_digest": {
          "description": "The image's digest. Given, it is what is pulled and run, so a tag moved on the registry changes nothing here.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "worker_agent_image": {
          "description": "The repository the engine publishes to. By default docker.io/skorcius/octopushy.",
          "type": "string",
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(\\.[a-z0-9-]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+(?![\\s\\S])"
        },
        "worker_agent_name": {
          "description": "The name the agent enrolls as, shown under Agents. By default the guest's name. Read at enrollment only.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,62}(?![\\s\\S])"
        },
        "worker_agent_labels": {
          "description": "The labels the enrollment token was created with. An agent cannot choose its labels: the server gives it its token's. Setup only prints these; they say what the worker is for, and are what a wizard would create the token with.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*(?![\\s\\S])"
          }
        },
        "worker_fedora_releases": {
          "description": "The Fedora releases this worker may run. Widen it when moving to a new one.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+(?![\\s\\S])"
          }
        },
        "worker_min_free_disk_mb": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "worker_server_url",
        "worker_agent_version"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "hardware",
    "network",
    "inputs"
  ],
  "$defs": {
    "ipv4": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?![\\s\\S])"
    },
    "ipv4Cidr": {
      "type": "string",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])(?![\\s\\S])"
    }
  }
}
