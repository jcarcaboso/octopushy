    "gen:api": "openapi-typescript ../contracts/openapi/octopushy.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "lucide-react": "^1.60.0",
    "monaco-editor": "0.57.0",
