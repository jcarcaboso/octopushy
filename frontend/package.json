{
  "name": "octopushy-frontend",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
