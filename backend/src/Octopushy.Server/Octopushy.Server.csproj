<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>octopushy-server</AssemblyName>
    <RootNamespace>Octopushy.Server</RootNamespace>
    <UserSecretsId>octopushy-server</UserSecretsId>
    <!-- Writes contracts/openapi/octopushy.json at build time; the frontend generates its client from it. -->
    <OpenApiDocumentsDirectory>$(ContractsDir)openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOptions>--file-name octopushy</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="$(ContractsDir)agent/v1/agent.proto" GrpcServices="Server" Link="Protos/agent.proto" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Octopushy.Definitions/Octopushy.Definitions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Octopushy.Tests" />
  </ItemGroup>
</Project>
