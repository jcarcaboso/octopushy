{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical",
      "Microsoft.AspNetCore.DataProtection": "Error"
    }
  },
  "AllowedHosts": "*",
  "Octopushy": {
    "DataDirectory": "/var/lib/octopushy",
    "ApiPort": 8080,
    "AgentChannel": {
      "Port": 8443,
      "Hostnames": []
    }
  }
}
