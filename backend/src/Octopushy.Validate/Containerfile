# The offline validator: `octopushy-validate`, and the Git CLI it fetches a workflows repository's tags with.
# For the CI of a lab repository and of a workflows repository. Build from the repository root:
#   docker build -f backend/src/Octopushy.Validate/Containerfile -t octopushy-validate:<version> .
# Run against a checkout:
#   docker run --rm -v "$PWD:/repo:ro" octopushy-validate:<version> /repo
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY contracts/ contracts/
COPY backend/ backend/
RUN dotnet publish backend/src/Octopushy.Validate \
      --configuration Release \
      --runtime linux-x64 \
      --self-contained \
      --output /app

FROM mcr.microsoft.com/dotnet/runtime-deps:10.0
RUN apt-get update \
 && apt-get install --yes --no-install-recommends git openssh-client ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /opt/octopushy-validate/octopushy-validate /usr/local/bin/octopushy-validate
COPY --from=build /app /opt/octopushy-validate
# A mounted checkout belongs to another user; Git refuses to read it unless told it is safe.
RUN git config --system --add safe.directory '*'
# No USER: a CI container job (GitHub Actions `container:`) checks out into a workspace only root can write.
ENTRYPOINT ["/opt/octopushy-validate/octopushy-validate"]
