# Copy to .env and fill in.
POSTGRES_PASSWORD=change-me
# The host name or address agents use to reach the control host.
OCTOPUSHY_AGENT_HOST=octopushy.home.arpa
OCTOPUSHY_AGENT_PORT=8443
# Where the web interface listens. Keep 127.0.0.1 unless TLS is in front of it.
OCTOPUSHY_UI_BIND=127.0.0.1
OCTOPUSHY_UI_PORT=8081
# Images built by hand with `just images <version>`.
OCTOPUSHY_BACKEND_IMAGE=localhost/octopushy-backend:dev
OCTOPUSHY_FRONTEND_IMAGE=localhost/octopushy-frontend:dev

# Install the guest disk reporter automatically after provisioning.
# Build/publish a guest-compatible binary, fill all three values, then enable.
OCTOPUSHY_DISK_REPORTER_ENABLED=false
OCTOPUSHY_DISK_REPORTER_PUBLIC_URL=
OCTOPUSHY_DISK_REPORTER_BINARY_URL=
OCTOPUSHY_DISK_REPORTER_BINARY_SHA256=
OCTOPUSHY_DISK_REPORTER_INTERVAL_SECONDS=3600
# Optional public CA PEM, used for BOTH binary download and reporting.
# OCTOPUSHY_DISK_REPORTER_CA_PEM='-----BEGIN CERTIFICATE-----...'
