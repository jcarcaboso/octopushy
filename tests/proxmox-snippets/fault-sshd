#!/bin/sh
# Test only: sshd, except that `sshd -t` fails on its Nth call once /run/fault/sshd-t holds N.
if [ "${1:-}" = "-t" ] && [ -f /run/fault/sshd-t ]; then
  n=$(( $(cat /run/fault/sshd-t-count 2>/dev/null || echo 0) + 1 ))
  echo "$n" > /run/fault/sshd-t-count
  if [ "$n" = "$(cat /run/fault/sshd-t)" ]; then echo "fault: sshd -t fails on call $n" >&2; exit 1; fi
fi
exec /usr/sbin/sshd "$@"
