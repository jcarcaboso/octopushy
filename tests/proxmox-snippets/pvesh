#!/usr/bin/env python3
"""Answers `pvesh get /storage/<id> --output-format json` from a JSON file, as Proxmox would."""
import json, sys
args = sys.argv[1:]
stores = json.load(open("/etc/pve-stub/storage.json"))
if len(args) >= 2 and args[0] == "get" and args[1].startswith("/storage/"):
    name = args[1].split("/")[2]
    if name not in stores:
        sys.exit(f"storage '{name}' does not exist")
    print(json.dumps({"storage": name, **stores[name]}))
    sys.exit(0)
sys.exit(f"pvesh stub: unsupported {args}")
